# 运行环境，未配置时默认 production
# NODE_ENV=production

# 服务监听主机，默认 localhost
# HOST_NAME=localhost

# 服务监听端口，默认 3000
# PORT=3000

# MySQL 用户名
# MYSQL_USERNAME=example

# MYSQL 密码
# MYSQL_PWD=example

# MySQL 地址，默认 localhost:3306
# MYSQL_HOSTPORT=localhost:3306

# MySQL 数据库名，默认 napflow_db
# MYSQL_DATABASE=napflow_db

# Root 账户邮箱
# ACC_ROOT_EMAIL=example

# Root 账户昵称
# ACC_ROOT_NICKNAME=example

# Root 账户密码
# ACC_ROOT_PASSWORD=example

# 启用 Root 账户同步标记
## 设置任意值即启用：每次启动时将 Root 账户信息同步为当前 .env 中的配置值
## 未设置时：仅在 Root 账户不存在时创建，已存在则跳过
# SYNC_ROOT_ACCOUNT_FLAG=true

## JWT 签名密钥，未设置时每次启动随机生成 32 字节 hex 字符串
## 开发模式建议在 .env.development 中配置固定值，防止 NestJS 热重载后 Token 失效导致被踢下线
# JWT_SECRET_KEY=your-secret-key