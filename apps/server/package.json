{
  "name": "server",
  "scripts": {
    "build": "npx nest build",
    "start": "npx cross-env NODE_ENV=development nest start",
    "start:dev": "pnpm start --watch",
    "start:debug": "pnpm start --debug --watch",
    "start:prod": "node dist/server/src/main.js",
    "lint": "eslint --fix",
    "lint:prettier": "npx prettier --write .",
    "lint:all": "pnpm lint:prettier && pnpm lint",
    "test": "npx vitest run",
    "test:unit": "npx vitest run --exclude test/**/*.e2e-spec.ts",
    "test:watch": "npx vitest",
    "test:cov": "npx vitest run --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/vitest --run --no-file-parallelism"
  },
  "dependencies": {
    "@langchain/core": "^1.1.35",
    "@langchain/openai": "^1.3.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.17",
    "@rdjksp/node-napcat-ts": "^0.4.20",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.2.36",
    "mysql2": "^3.15.3",
    "nestjs-zod": "^5.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "simple-statistics": "^7.8.8",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/config": "^4.0.2",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9"
  }
}
