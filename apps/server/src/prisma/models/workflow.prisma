model WorkflowApp {
    appId               String               @id @default(uuid())
    appName             String
    appDescription      String
    createdAt           DateTime             @default(now())
    createdBy           String
    workflowAppPublishs WorkflowAppPublish[]
    workflowAppDatas    WorkflowAppData[]

    @@map("apps")
}

model WorkflowAppPublish {
    version     String           @default("draft")
    description String?
    publishAt   DateTime        @default(now())
    publishBy   String?
    //relations
    ofAppId     String
    ofApp       WorkflowApp      @relation(fields: [ofAppId], references: [appId], onDelete: Cascade)
    ofData      WorkflowAppData?

    @@id([version, ofAppId])
    @@map("app_publishs")
}

model WorkflowAppData {
    dataId           String             @id @default(uuid())
    //relations
    ofAppId          String
    ofApp            WorkflowApp        @relation(fields: [ofAppId], references: [appId], onDelete: Cascade)
    ofPublishVersion String
    ofPublish        WorkflowAppPublish @relation(fields: [ofPublishVersion, ofAppId], references: [version, ofAppId], onDelete: Cascade)
    //areas

    @@unique([ofPublishVersion, ofAppId])
    @@map("app_datas")
}
