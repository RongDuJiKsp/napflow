{
  "name": "proxy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "cross-env NODE_ENV=development tsx src/index.ts",
    "start:dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/proxy/src/index.js",
