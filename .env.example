# Copy this file to .env.local before running docker compose.
# Do not commit your real .env.local file.

# -----------------------------
# MySQL
# -----------------------------
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=napflow_db
MYSQL_USER=napflow
MYSQL_PASSWORD=change_this_app_password

# Optional: only binds MySQL to localhost for safer access.
MYSQL_BIND_PORT=3306

# -----------------------------
# NapFlow Server
# -----------------------------
ACC_ROOT_EMAIL=root@napflow.com
ACC_ROOT_NICKNAME=rootUser
ACC_ROOT_PASSWORD=change_this_root_account_password
JWT_SECRET_KEY=replace_with_at_least_32_chars_random_secret

# Optional bind settings
SERVER_BIND_IP=0.0.0.0
SERVER_PORT=8848
WEB_BIND_IP=0.0.0.0
WEB_PORT=3000

# Optional web API base path
NEXT_PUBLIC_API_URL=/api
