{
  "name": "napflow",
  "version": "0.1.2",
  "description": "",
  "scripts": {
    "image:web": "docker build -f apps/web/Dockerfile .  -t napflow/web",
    "image:server": "docker build -f apps/server/Dockerfile .  -t napflow/server",
    "test": "npx vitest run",
    "release:snapshot": "PREFIX=v$(node -p \"require('./package.json').version\")-snapshot-$(date +%y%m%d) && COUNT=$(git tag -l \"${PREFIX}*\" | wc -l | tr -d ' ') && NUM=$(printf '%02d' $((COUNT+1))) && TAG=${PREFIX}${NUM} && echo \"Creating tag: $TAG\" && git tag $TAG && git push origin $TAG",
    "release": "TAG=v$(node -p \"require('./package.json').version\") && echo \"Creating tag: $TAG\" && git tag $TAG && git push origin $TAG",
    "docker:buildandup": "docker compose --env-file .env.local up -d"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@types/lodash-es": "^4.17.12",
    "cpx": "^1.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-plugin-oxlint": "^1.29.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "type-fest": "^5.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "datastructures-js": "^13.0.0",
    "dotenv": "^17.3.1",
    "lodash-es": "^4.17.23",
    "mnemonist": "^0.40.3",
    "ring-buffer-ts": "^1.2.0",
    "zod": "^4.1.12",
    "zod-deep-partial": "^1.2.0"
  }
}
